<clickhouse>
    <listen_host>0.0.0.0</listen_host>

    <remote_servers>
        <default>
            <shard>
                <replica>
                    <host>ch-clickhouse-0</host>
                    <port>9000</port>
                </replica>
                <replica>
                    <host>ch-clickhouse-1</host>
                    <port>9000</port>
                </replica>
            </shard>
        </default>
    </remote_servers>

    <zookeeper>
        <node>
            <host>ch-keeper-0</host>
            <port>9181</port>
        </node>
    </zookeeper>

    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
    </prometheus>
</clickhouse>
