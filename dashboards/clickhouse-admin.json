          {
            "matcher": { "id": "byName", "options": "count" },
            "properties": [
              { "id": "custom.width", "value": 100 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 1 },
                    { "color": "red", "value": 100 }
                  ]
                }
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          }
        ]
      },
      "options": { "sortBy": [{ "displayName": "count", "desc": true }] },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "${ch_datasource}" },
          "rawSql": "SELECT name, value AS count, toDateTime(last_error_time) AS last_error_time FROM system.errors WHERE value > 0 ORDER BY count DESC LIMIT 20",
          "refId": "A",
          "format": "table"
        }
      ]
    },

    {
      "id": 82,
      "type": "timeseries",
      "title": "Failed Queries/sec — per Pod",
      "gridPos": { "x": 12, "y": 137, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Rate of failed queries per pod. A spike on one pod points to a bad replica.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15, "spanNulls": false, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(ClickHouseProfileEvents_FailedQuery{pod=~\"$pod\"}[5m])",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    }

  ]
}
