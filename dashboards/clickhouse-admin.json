      "options": { "sortBy": [{ "displayName": "lag_seconds", "desc": true }] },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "${ch_datasource}" },
          "rawSql": "SELECT hostname() AS pod, max(dateDiff('second', create_time, now())) AS lag_seconds FROM clusterAllReplicas('$cluster', system.replication_queue) GROUP BY pod ORDER BY lag_seconds DESC",
          "refId": "A",
          "format": "table"
        }
